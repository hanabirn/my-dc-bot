# 這份檔案只是列出 Render 上要設定的環境變數名稱，不要填真的密鑰進來、也不要 commit 真的 .env

# pp_checker
PP_DISCORD_TOKEN=
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# miku39
MIKU_TOKEN=
MIKU_OSU_API_KEY=
# 要監聽戰績訊息的那支 bot 的 Discord user ID（開發者模式下右鍵該 bot 訊息 -> 複製使用者 ID）
# 沒設定的話，miku39 就不會監聽任何訊息、跳過整個戰績互動功能
MIKU_TARGET_BOT_ID=

# osu_bot
OSU_BOT_DISCORD_TOKEN=
# 貼 firebase_key.json 的完整 JSON 內容（單行），不要用檔案
FIREBASE_CREDENTIALS=
